# Example environment variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local or real secrets to git

# Public (safe to expose)
NEXT_PUBLIC_APP_NAME=quietledger
NEXT_PUBLIC_CONTRACT_ID=your-contract-id-here

# Private (KEEP SECRET - never use NEXT_PUBLIC_ prefix)
# These are only used on the server side, never sent to the browser
PROOF_SERVER_URL=https://proof-server.midnight.network
PROOF_SERVER_API_KEY=your-api-key-here
